    "def plot_projection(M, title, n=60, seed=SEED):\n",
    "    \"\"\"Proyeksi cosine dari n vektor dengan degree terbesar; edge jika similarity > 0.\"\"\"\n",
    "    deg = np.diff(M.indptr)\n",
    "    top = np.argsort(-deg)[:n]\n",
    "    S = normalize(M[top])\n",
    "    sim = (S @ S.T).toarray()\n",
    "    np.fill_diagonal(sim, 0)\n",
    "    G = nx.Graph(); G.add_nodes_from(range(len(top)))\n",
    "    for a, b in zip(*np.nonzero(np.triu(sim))):\n",
    "        G.add_edge(int(a), int(b), weight=float(sim[a, b]))\n",
    "    pos = nx.spring_layout(G, seed=seed)\n",
    "    plt.figure(figsize=(7, 6))\n",
    "    nx.draw_networkx(G, pos, node_size=60, with_labels=False, width=0.4, alpha=0.8)\n",
    "    plt.title(f\"{title}  (node={G.number_of_nodes()}, edge={G.number_of_edges()})\"); plt.axis(\"off\"); plt.show()\n",
    "\n",
    "plot_projection(UI, \"Proyeksi User-User (60 user teraktif, cosine)\")\n",
    "plot_projection(IU, \"Proyeksi Item-Item (60 item terpopuler, cosine)\")\n",
    "\n",
    "# Graf bipartit contoh: 12 user acak (seed tetap) beserta maksimal 6 item per user\n",
    "rng = random.Random(SEED)\n",
    "cand = [k for k in range(UI.shape[0]) if UI.indptr[k + 1] - UI.indptr[k] >= 3]\n",
    "samp = rng.sample(cand, min(12, len(cand)))\n",
    "B = nx.Graph()\n",
    "for k in samp:\n",
    "    for j in UI.indices[UI.indptr[k]:UI.indptr[k + 1]][:6]:\n",
    "        B.add_edge((\"u\", int(users[k])), (\"i\", int(items[j])))\n",
    "colors = [\"tab:blue\" if n[0] == \"u\" else \"tab:orange\" for n in B.nodes]\n",
    "plt.figure(figsize=(8, 6)); nx.draw_networkx(B, nx.spring_layout(B, seed=SEED), node_color=colors, node_size=70, with_labels=False, width=0.5)\n",
    "plt.title(\"Graf bipartit Visitor (biru) - Item (oranye), sampel\"); plt.axis(\"off\"); plt.show()"
   ]
  },
