   "source": [
    "W = {\"VIEWED\": 1, \"ADDED_TO_CART\": 3, \"BOUGHT\": 5}\n",
    "rows = run(\"MATCH (v:Visitor)-[r:VIEWED|ADDED_TO_CART|BOUGHT]->(i:Item) RETURN v.visitorId AS u, i.itemId AS i, type(r) AS t\")\n",
    "inter = pd.DataFrame(rows)\n",
    "inter[\"w\"] = inter[\"t\"].map(W)\n",
    "inter = inter.groupby([\"u\", \"i\"], as_index=False)[\"w\"].sum()\n",
    "\n",
    "users = np.sort(inter[\"u\"].unique()); items = np.sort(inter[\"i\"].unique())\n",
    "u_idx = {u: k for k, u in enumerate(users)}; i_idx = {i: k for k, i in enumerate(items)}\n",
    "\n",
    "UI = sp.csr_matrix((inter[\"w\"].values.astype(np.float32),\n",
    "                    (inter[\"u\"].map(u_idx).values, inter[\"i\"].map(i_idx).values)),\n",
    "                   shape=(len(users), len(items)))\n",
    "IU = UI.T.tocsr()\n",
    "\n",
    "def describe(M, nama, entitas):\n",
    "    deg = np.diff(M.indptr)\n",
    "    total = M.shape[0] * M.shape[1]\n",
    "    return {\"VSM\": nama, \"shape\": M.shape, \"dimensi_vektor\": M.shape[1], \"jumlah_vektor\": M.shape[0],\n",
    "            \"nnz\": M.nnz, \"sparsity_%\": round(100 * (1 - M.nnz / total), 4),\n",
    "            \"rata2_nnz_per_vektor\": round(deg.mean(), 2), \"median\": float(np.median(deg)), \"maks\": int(deg.max()),\n",
    "            \"memori_MB\": round((M.data.nbytes + M.indices.nbytes + M.indptr.nbytes) / 1e6, 2)}\n",
    "\n",
    "pd.DataFrame([describe(UI, \"User (user x item)\", \"user\"), describe(IU, \"Item (item x user)\", \"item\")]).T"
   ]
  },
