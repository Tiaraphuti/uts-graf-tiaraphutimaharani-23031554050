   "source": [
    "sample_users = random.Random(SEED).sample(eligible, min(200, len(eligible)))\n",
    "def evaluate(fn, users_):\n",
    "    H, D = [], []\n",
    "    for u in tqdm(users_, desc=\"Evaluasi\", leave=False):\n",
    "        r, g = fn(u), ground_truth(u)\n",
    "        H.append(hit_at(r, g)); D.append(ndcg_at(r, g))\n",
    "    return round(float(np.mean(H)), 4), round(float(np.mean(D)), 4)\n",
    "\n",
    "pop_only = lambda u: [i for i in popular if i not in p1_items.get(u, set())][:N]\n",
    "rows_eval = []\n",
    "for nama, fn in [(\"KNN saja\", recommend_knn), (\"KNN + fallback populer\", recommend), (\"Populer saja (baseline)\", pop_only)]:\n",
    "    h, d = evaluate(fn, sample_users)\n",
    "    rows_eval.append({\"metode\": nama, \"Hit@5\": h, \"NDCG@5\": d})\n",
    "display(pd.DataFrame(rows_eval))\n",
    "print(f\"Jumlah user dievaluasi: {len(sample_users)}\")\n",
    "print(\"Rata-rata jumlah item hasil KNN per user (maks 5):\", round(float(np.mean([len(recommend_knn(u)) for u in sample_users])), 2))"
   ]
