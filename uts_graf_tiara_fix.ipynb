   "source": [
    "### Impor P1 ke Neo4j (batch)\n",
    "Hanya **P1** yang masuk ke graf. P2 dipakai sebagai *ground truth* untuk evaluasi (Hit@5 dan NDCG@5), jadi tidak boleh bocor ke graf.\n",
    "Graf: `(:Visitor)-[:VIEWED | :ADDED_TO_CART | :BOUGHT {timestamp}]->(:Item)`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "d81f3822",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Received notification from DBMS server: {severity: WARNING} {code: Neo.ClientNotification.Statement.FeatureDeprecationWarning} {category: DEPRECATION} {title: This feature is deprecated and will be removed in future versions.} {description: CALL subquery without a variable scope clause is now deprecated. Use CALL () { ... }} {position: line: 1, column: 1, offset: 0} for query: 'CALL { MATCH (n) DETACH DELETE n } IN TRANSACTIONS OF 10000 ROWS'\n"
     ]
    },
    {
     "data": {
      "application/vnd.jupyter.widget-view+json": {
       "model_id": "f65d7955c86d4fe0a7de477a7b7f36ad",
       "version_major": 2,
       "version_minor": 0
      },
      "text/plain": [
       "Mengimpor batch:   0%|          | 0/64 [00:00<?, ?it/s]"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Impor selesai\n"
     ]
    }
   ],
   "source": [
    "# Kosongkan database (hati-hati pada shared database) lalu buat constraint\n",
    "run(\"CALL { MATCH (n) DETACH DELETE n } IN TRANSACTIONS OF 10000 ROWS\")\n",
    "run(\"CREATE CONSTRAINT visitor_id IF NOT EXISTS FOR (v:Visitor) REQUIRE v.visitorId IS UNIQUE\")\n",
    "run(\"CREATE CONSTRAINT item_id IF NOT EXISTS FOR (i:Item) REQUIRE i.itemId IS UNIQUE\")\n",
    "\n",
    "NODE_Q = \"\"\"\n",
    "UNWIND $batch AS row\n",
    "MERGE (v:Visitor {visitorId: row.visitorid})\n",
    "MERGE (i:Item {itemId: row.itemid})\n",
    "\"\"\"\n",
    "REL_Q = {\n",
    "    \"view\": \"\"\"UNWIND $batch AS row\n",
    "        MATCH (v:Visitor {visitorId: row.visitorid}) MATCH (i:Item {itemId: row.itemid})\n",
    "        CREATE (v)-[:VIEWED {timestamp: row.timestamp}]->(i)\"\"\",\n",
    "    \"addtocart\": \"\"\"UNWIND $batch AS row\n",
    "        MATCH (v:Visitor {visitorId: row.visitorid}) MATCH (i:Item {itemId: row.itemid})\n",
    "        CREATE (v)-[:ADDED_TO_CART {timestamp: row.timestamp}]->(i)\"\"\",\n",
    "    \"transaction\": \"\"\"UNWIND $batch AS row\n",
    "        MATCH (v:Visitor {visitorId: row.visitorid}) MATCH (i:Item {itemId: row.itemid})\n",
    "        CREATE (v)-[:BOUGHT {timestamp: row.timestamp, transactionId: row.transactionid}]->(i)\"\"\",\n",
    "}\n",
    "\n",
    "def import_batch(tx, batch):\n",
    "    tx.run(NODE_Q, batch=batch)\n",
    "    for ev, q in REL_Q.items():\n",
    "        rows = [r for r in batch if r[\"event\"] == ev]\n",
    "        if rows:\n",
    "            tx.run(q, batch=rows)\n",
    "\n",
    "BATCH = 10_000\n",
    "total_chunks = math.ceil(len(p1) / BATCH)\n",
    "chunks = pd.read_csv(DATA / \"events_p1.csv\", chunksize=BATCH)\n",
    "\n",
    "with driver.session(database=\"neo4j\") as session:\n",
    "    for chunk in tqdm(chunks, total=total_chunks, desc=\"Mengimpor batch\"):\n",
    "        chunk[\"transactionid\"] = chunk[\"transactionid\"].fillna(-1).astype(\"int64\")  # NaN -> -1\n",
    "        session.execute_write(import_batch, chunk.to_dict(orient=\"records\"))\n",
    "print(\"Impor selesai\")"
   ]
  },
