   "source": [
    "# UTS Graf Sains Data — RetailRocket + Neo4j\n",
    "\n",
    "**Periode (UTC, timestamp dalam milidetik)**\n",
    "- P1 (training): 2015-05-25 00:00:00 s.d. sebelum 2015-06-25 00:00:00\n",
    "- P2 (testing): 2015-06-25 00:00:00 s.d. sebelum 2015-07-23 00:00:00\n",
    "\n",
    "**Alur:** filter data → impor P1 ke Neo4j → komposisi graf → VSM user/item → bandingkan proyeksi → similarity (GDS) → KNN → Hit@5 dan NDCG@5 (ground truth dari P2).\n",
    "\n",
    "Sebelum menjalankan: Neo4j (Docker) harus aktif dan `data/events.csv` harus ada."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "2fadeb56",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "P1_START 2015-05-25 00:00:00\n",
      "P1_END 2015-06-25 00:00:00\n",
      "P2_START 2015-06-25 00:00:00\n",
      "P2_END 2015-07-23 00:00:00\n",
      "Terhubung ke Neo4j\n"
     ]
    }
   ],
   "source": [
    "import math, random\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import scipy.sparse as sp\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.preprocessing import normalize\n",
    "from tqdm.auto import tqdm\n",
    "from neo4j import GraphDatabase\n",
    "\n",
    "URI = \"bolt://localhost:7687\"\n",
    "AUTH = (\"neo4j\", \"password123\")\n",
    "DATA = Path(\"data\")\n",
    "SEED = 42\n",
    "\n",
    "# Batas periode (epoch milidetik, UTC). Filter: START <= ts < END\n",
    "P1_START, P1_END = 1432512000000, 1435190400000\n",
    "P2_START, P2_END = 1435190400000, 1437609600000\n",
    "\n",
    "for nama, v in [(\"P1_START\", P1_START), (\"P1_END\", P1_END), (\"P2_START\", P2_START), (\"P2_END\", P2_END)]:\n",
    "    print(nama, pd.to_datetime(v, unit=\"ms\"))\n",
    "\n",
    "driver = GraphDatabase.driver(URI, auth=AUTH)\n",
    "driver.verify_connectivity()\n",
    "print(\"Terhubung ke Neo4j\")\n",
    "\n",
    "def run(query, **params):\n",
    "    \"\"\"Jalankan satu query Cypher dan kembalikan list of dict.\"\"\"\n",
    "    with driver.session(database=\"neo4j\") as s:\n",
    "        return s.run(query, **params).data()"
   ]
  },
